{
  "name": "gomla-market",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "fabric": "^7.4.0",
    "lucide-react": "^1.62.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.gomlamarket.marketerid",
    "productName": "Marketer ID",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "backend-bundle/src",
        "to": "server/src"
      },
      {
        "from": "backend-bundle/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "backend-bundle/package.json",
        "to": "server/package.json"
      },
      {
        "from": "backend-bundle/package-lock.json",
        "to": "server/package-lock.json"
      },
      {
        "from": "backend-bundle/.env",
        "to": "server/.env"
      },
      {
        "from": "resources/node.exe",
        "to": "node.exe"
      },
      {
        "from": "dist",
        "to": "dist"
      }
    ]
  }
}